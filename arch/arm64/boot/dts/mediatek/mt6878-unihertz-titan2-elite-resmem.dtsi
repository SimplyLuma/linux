		no-map;
	};
	titan-apu-sapu-apurvgzctrlshm@8f600000 {
		reg = <0x0 0x8f600000 0x0 0x100000>;
		no-map;
	};
	titan-apu-apusys-rv-aee-coredump@8f7a0000 {
		reg = <0x0 0x8f7a0000 0x0 0x260000>;
