		no-map;
	};
	titan-adsp-shared-reserved@9e000000 {
		reg = <0x0 0x9e000000 0x0 0xb70000>;
		no-map;
	};
	titan-debug-met-res-ram@9f3ff000 {
		reg = <0x0 0x9f3ff000 0x0 0xc00000>;
		no-map;
	};
	titan-scp-reserved@b8000000 {
		reg = <0x0 0xb8000000 0x0 0x2300000>;
		no-map;
	};
	titan-me-vcp-reserved@bf500000 {
		reg = <0x0 0xbf500000 0x0 0x800000>;
		no-map;
	};
	titan-ccci-tag-mem@bfdf0000 {
		reg = <0x0 0xbfdf0000 0x0 0x10000>;
