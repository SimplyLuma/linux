	titan-platform-mtksmmu-protpgd@fae00000 {
		reg = <0x0 0xfae00000 0x0 0x4200000>;
		no-map;
	};
	titan-framebuffer@ff0cf000 {
		reg = <0x0 0xff0cf000 0x0 0xf30000>;
		no-map;
	};
	titan-dramc-rk0@1bfffe000 {
		reg = <0x1 0xbfffe000 0x0 0x2000>;
		no-map;
	};
	titan-gz-log@33d600000 {
		reg = <0x3 0x3d600000 0x0 0x41000>;
		no-map;
	};
	titan-unmap2@33d800000 {
		reg = <0x3 0x3d800000 0x0 0x200000>;
		no-map;
	};
	titan-mkp@33da00000 {
		reg = <0x3 0x3da00000 0x0 0x200000>;
