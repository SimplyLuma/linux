		no-map;
	};
	titan-mm-ccu-reserved@80000000 {
		reg = <0x0 0x80000000 0x0 0x100000>;
		no-map;
	};
	titan-consys-emi-reserved@87e00000 {
		reg = <0x0 0x87e00000 0x0 0x2120000>;
		no-map;
	};
	titan-shared-dma-pool-wifi-reserve-memory-dma@88b00000 {
		reg = <0x0 0x88b00000 0x0 0x1400000>;
		no-map;
	};
	titan-consys-scp-emi-reserved@89f00000 {
		reg = <0x0 0x89f00000 0x0 0x20000>;
		no-map;
	};
	titan-ap-md-c-smem@8a000000 {
