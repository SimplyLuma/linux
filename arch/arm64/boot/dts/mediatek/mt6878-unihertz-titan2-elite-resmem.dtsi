/* Titan 2 Elite firmware carve-outs: preloader + LK allocations from the stock boot log (expdb, 2026-10-17). */
&{/reserved-memory} {
	titan-aee-debug-kinfo@48080000 {
		reg = <0x0 0x48080000 0x0 0x10000>;
		no-map;
	};
	/* Same layout as stock Android's ramoops, so Android shows our last console. */
	ramoops@48090000 {
		compatible = "ramoops";
		reg = <0x0 0x48090000 0x0 0xe0000>;
		record-size = <0x1000>;
		console-size = <0x40000>;
		ftrace-size = <0x1000>;
		pmsg-size = <0x80000>;
		max-reason = <2>;
	};
	titan-minirdump@48170000 {
		reg = <0x0 0x48170000 0x0 0x10000>;
		no-map;
	};
	titan-crypto-hw@48401000 {
		reg = <0x0 0x48401000 0x0 0x1000>;
		no-map;
	};
	titan-bl31-reserved@48800000 {
		reg = <0x0 0x48800000 0x0 0x200000>;
		no-map;
	};
	titan-security-dice-pvmfw@6fffd000 {
		reg = <0x0 0x6fffd000 0x0 0x1000>;
		no-map;
	};
	titan-security-dice-common@6fffe000 {
		reg = <0x0 0x6fffe000 0x0 0x1000>;
		no-map;
	};
	titan-security-tee-sig@6ffff000 {
		reg = <0x0 0x6ffff000 0x0 0x1000>;
		no-map;
	};
	titan-tee-reserved@70000000 {
		reg = <0x0 0x70000000 0x0 0x3c00000>;
		no-map;
	};
	titan-spm-reserved@77ff0000 {
		reg = <0x0 0x77ff0000 0x0 0x10000>;
		no-map;
	};
	titan-system-bl2-ext@78000000 {
		reg = <0x0 0x78000000 0x0 0x2000000>;
		no-map;
	};
	titan-aee-lk@7e000000 {
		reg = <0x0 0x7e000000 0x0 0x800000>;
		no-map;
	};
	titan-me-gpumputab-pma@7e800000 {
		reg = <0x0 0x7e800000 0x0 0x600000>;
		no-map;
	};
	titan-me-gpu-reserved@7ee00000 {
		reg = <0x0 0x7ee00000 0x0 0x200000>;
		no-map;
	};
	titan-tee-secmem@7f000000 {
		reg = <0x0 0x7f000000 0x0 0x900000>;
		no-map;
	};
	titan-sspm-ap-shared@7f970000 {
		reg = <0x0 0x7f970000 0x0 0x110000>;
		no-map;
	};
	titan-mcupm-reserved@7fa80000 {
		reg = <0x0 0x7fa80000 0x0 0x100000>;
		no-map;
	};
	titan-sspm-reserved@7fb80000 {
		reg = <0x0 0x7fb80000 0x0 0x280000>;
		no-map;
	};
	titan-system-bl31-dtb@7fe00000 {
		reg = <0x0 0x7fe00000 0x0 0x100000>;
		no-map;
	};
	/* GPUEB gpufreq shared memory (handed to the EB with CMD_INIT_SHARED_MEM). */
	gpueb_shared_memory: memory@7fe70000 {
		reg = <0x0 0x7fe70000 0x0 0x4000>;
		no-map;
	};
	titan-me-gpueb-shared@7fe74000 {
		reg = <0x0 0x7fe74000 0x0 0x7c000>;
		no-map;
	};
	titan-me-gpueb-fw@7fef0000 {
		reg = <0x0 0x7fef0000 0x0 0x100000>;
		no-map;
	};
	titan-emi-mbist-buf@7ffff000 {
